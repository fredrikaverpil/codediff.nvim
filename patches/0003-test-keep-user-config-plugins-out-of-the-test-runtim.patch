From 5868e15311ecb0448d390a9c4f00e82bb3803dbb Mon Sep 17 00:00:00 2001
From: Fredrik Averpil <fredrik.averpil@proton.me>
Date: Wed, 5 Aug 2026 16:29:40 +0200
Subject: [PATCH 3/4] test: keep user config plugins out of the test
 runtimepath

`runtime! plugin/*.lua` is what deliberately defeats `--noplugin` here, but it
also sources the developer's own `plugin/` directory. Any error raised there
aborts tests/init.lua before a single spec runs, so the suite fails wholesale
on a machine whose personal config happens to be incompatible.

Drop the user config and site directories from 'runtimepath' for the duration
of that one call, so Neovim's own runtime plugins still load as intended.
---
 tests/init.lua | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/tests/init.lua b/tests/init.lua
index f509f39..36a4626 100644
--- a/tests/init.lua
+++ b/tests/init.lua
@@ -64,8 +64,23 @@ vim.opt.swapfile = false
 -- Neovim's runtime plugins despite `--noplugin`.
 vim.g.loaded_autoread = 1
 
--- Load plugin files (for integration tests that need commands)
+-- Load plugin files (for integration tests that need commands).
+--
+-- The user's own config directories are dropped from 'runtimepath' first: this
+-- `runtime!` is what defeats `--noplugin`, so without the filter it also sources
+-- whatever lives in the developer's personal `plugin/` directory, and any error
+-- raised there aborts tests/init.lua before a single spec runs.
+local user_dirs = {
+  vim.fn.stdpath("config"),
+  vim.fn.stdpath("data") .. "/site",
+}
+local saved_rtp = vim.o.runtimepath
+for _, dir in ipairs(user_dirs) do
+  vim.opt.rtp:remove(dir)
+  vim.opt.rtp:remove(dir .. "/after")
+end
 vim.cmd("runtime! plugin/*.lua plugin/*.vim")
+vim.o.runtimepath = saved_rtp
 
 -- Setup plugin
 require("codediff").setup()
-- 
